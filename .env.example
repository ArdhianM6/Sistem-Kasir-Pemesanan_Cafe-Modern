# Supabase PostgreSQL connection string. Vercel integration supplies POSTGRES_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Use the Supabase project's JWT secret locally. Vercel integration supplies this.
SUPABASE_JWT_SECRET=your-project-jwt-secret

TAX_RATE=0.10
SERVICE_RATE=0.05
LOW_STOCK_LIMIT=5
